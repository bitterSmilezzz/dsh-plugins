{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "DSH 记忆插件：自动日志 + 自动画像 + 启动摘要，独立 bundle（按需安装）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitterSmilezzz/dsh-memory.git"
  },
  "homepage": "https://github.com/bitterSmilezzz/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/bitterSmilezzz/dsh-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7"
  }
}
